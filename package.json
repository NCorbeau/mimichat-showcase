{
  "name": "mimichat-showcase",
  "private": true,
  "overrides": {
    "monday-ui-style": {
      "postcss": "^8.5.28"
    }
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:mock": "cd ./src/ui/app/mimichat-main && vite --config vite.config.mock.ts",
    "dev:board:mock": "cd ./src/ui/app/mimichat-board && vite --config vite.config.mock.ts",
    "lint": "eslint . --ext ts,tsx",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run build:mock && npm run build:board:mock",
    "build:mock": "cd ./src/ui/app/mimichat-main && tsc && vite build --config vite.config.mock.ts",
    "build:board:mock": "cd ./src/ui/app/mimichat-board && tsc && vite build --config vite.config.mock.ts",
    "preview:mock": "cd ./src/ui/app/mimichat-main && vite preview --config vite.config.mock.ts"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "luxon": "^3.4.4",
    "monday-ui-react-core": "^2.134.1",
    "notistack": "^3.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-virtuoso": "^4.7.4"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.33",
    "sass": "^1.69.7",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
